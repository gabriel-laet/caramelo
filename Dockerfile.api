FROM python:3.12-slim

WORKDIR /app
COPY pyproject.toml README.md LICENSE ./
COPY src ./src
RUN pip install --no-cache-dir .[api]

# The API queries the public lake over HTTP — no credentials required.
ENV CARAMELO_LAKE=https://pub-b18c9a8d60c74f5080b0a1abd4045f2b.r2.dev/latest \
    PYTHONUNBUFFERED=1

EXPOSE 8080
CMD ["uvicorn", "caramelo.serve:app", "--host", "0.0.0.0", "--port", "8080"]
