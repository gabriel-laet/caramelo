// Caramelo harvest scheduler: cron-triggered Worker that runs the harvest
// container.
{
  "name": "caramelo-scheduler",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "containers": [
    {
      "class_name": "HarvestContainer",
      // Pre-pushed via `wrangler containers push` (a path to the repo's
      // Dockerfile also works where Docker can build it).
      "image": "registry.cloudflare.com/2cdbde3608c5914c43e4433fd39ba6b2/caramelo:cf",
      "instance_type": "standard-1",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "HARVESTER", "class_name": "HarvestContainer" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["HarvestContainer"] }
  ],
  "triggers": {
    // 09:00 UTC daily — after Portal da Transparência refreshes its dumps
    "crons": ["0 9 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
